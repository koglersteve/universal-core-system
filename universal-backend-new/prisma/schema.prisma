datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//
// ─────────────────────────────────────────────
//  USER + CORE FEED MODELS
// ─────────────────────────────────────────────
//

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String?
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())

  posts      Post[]
  favorites  Favorite[]
  histories  History[]
}

model Post {
  id        String    @id @default(cuid())
  title     String
  content   String
  tags      String[]
  score     Int       @default(0)
  createdAt DateTime  @default(now())

  author    User?     @relation(fields: [authorId], references: [id])
  authorId  String?

  favorites Favorite[]
  histories History[]
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model History {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  viewedAt  DateTime @default(now())
}

//
// ─────────────────────────────────────────────
//  CROSS‑APP EMOTIONAL ENGINE MODELS
// ─────────────────────────────────────────────
//

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  emoji     String?
  app       String?
  createdAt DateTime @default(now())
}

model Impression {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  type      String?   // optional because worker does not always send it
  app       String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  payload   Json
  type      String?
  userId    String?
  postId    String?   // REQUIRED — worker writes this
  app       String?   // REQUIRED — worker writes this
  emoji     String?   // REQUIRED 
  createdAt DateTime @default(now())
}
