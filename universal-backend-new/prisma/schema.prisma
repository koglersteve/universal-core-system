generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ─────────────────────────────────────────────────────────────
//   UNIVERSAL CORE MODELS (STABLE, NEVER APP-SPECIFIC)
// ─────────────────────────────────────────────────────────────
//

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  screenName String
  avatarUrl  String?
  password   String
  createdAt  DateTime @default(now())

  posts               Post[]
  passwordResetTokens PasswordResetToken[]
  settings            UserSettings?

  // Universal analytics
  reactions   Reaction[]
  impressions Impression[]
  events      AnalyticsEvent[]
}

model UserSettings {
  userId    String   @id
  theme     String?  @default("light")
  language  String?  @default("en")
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expires   DateTime
  createdAt DateTime @default(now())
}

//
// Universal Post Model (used by any app)
// Apps can extend via app-specific tables
//
model Post {
  id        String   @id @default(cuid())
  creatorId String
  createdAt DateTime @default(now())

  // Optional universal fields
  type      String?
  text      String?
  mediaUrl  String?
  score     Int      @default(0)

  // App identifier (e.g., "lafflab", "drama", "northstar")
  app       String?

  creator User @relation(fields: [creatorId], references: [id])

  // Universal analytics
  reactions   Reaction[]
  impressions Impression[]
  events      AnalyticsEvent[]
}

//
// Universal Emotional OS Analytics
//

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  app       String
  emoji     String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model Impression {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  app       String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String
  postId    String?
  app       String
  emoji     String?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post? @relation(fields: [postId], references: [id])
}
